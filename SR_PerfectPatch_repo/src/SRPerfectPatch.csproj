<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SRPerfectPatch</AssemblyName>
    <RootNamespace>SRPerfectPatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>SR Perfect Patch</Product>
    <AssemblyTitle>SR Perfect Patch — Symphonic Rain judgement overlay</AssemblyTitle>
    <Description>Read-only judgement overlay: Perfect / Good(Early|Late ms) / Miss, combo, and an end-of-song result card. No game file is ever modified.</Description>
    <Company>MUCT_POHRIZ</Company>
    <Copyright>(c) MUCT_POHRIZ. Built with assistance from DeepSeek Harness.</Copyright>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- 源码里用了 ? 可空标注但没开 nullable，属于无害警告，静音掉让构建输出干净 -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <!--
    两套外观，同一份源码：
      * 默认（NoArt 未指定）：如果当前目录里存在 frame_top.png / header_icon.png，
        就用它们做顶部帘幕与右上角立绘（这是「带美术版」，仅供本地自用，不要公开分发）。
      * 这两个文件不存在时自动切到 NOART：所有装饰改为程序自绘（纸面 + 酒红 + 五线谱 + 谱号字形），
        产物里不含任何游戏图片 —— 仓库和 Release 里发布的就是这一版。
    也可以显式指定：dotnet build -c Release -p:NoArt=true / -p:NoArt=false
  -->
  <PropertyGroup Condition="'$(NoArt)' == '' and !Exists('$(MSBuildProjectDirectory)\frame_top.png')">
    <NoArt>true</NoArt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NoArt)' == 'true'">
    <DefineConstants>$(DefineConstants);NOART</DefineConstants>
    <AssemblyTitle>SR Perfect Patch — Symphonic Rain judgement overlay (no-art build)</AssemblyTitle>
    <ApplicationIcon>app_noart.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NoArt)' != 'true'">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_rollback\**" />
    <EmbeddedResource Remove="_rollback\**" />
    <None Remove="_rollback\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(NoArt)' != 'true'">
    <EmbeddedResource Include="frame_top.png" LogicalName="frame_top.png" Condition="Exists('frame_top.png')" />
    <EmbeddedResource Include="header_icon.png" LogicalName="header_icon.png" Condition="Exists('header_icon.png')" />
  </ItemGroup>

</Project>
