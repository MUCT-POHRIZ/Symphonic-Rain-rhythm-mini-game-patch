<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SRPerfectPatch</AssemblyName>
    <RootNamespace>SRPerfectPatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>SR Perfect Patch</Product>
    <AssemblyTitle>SR Perfect Patch 鈥?Symphonic Rain judgement overlay</AssemblyTitle>
    <Description>Read-only judgement overlay: Perfect / Good(Early|Late ms) / Miss, combo, and an end-of-song result card. No game file is ever modified.</Description>
    <Company>MUCT_POHRIZ</Company>
    <Copyright>(c) MUCT_POHRIZ. Built with assistance from DeepSeek Harness.</Copyright>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- 婧愮爜閲岀敤浜?? 鍙┖鏍囨敞浣嗘病寮€ nullable锛屽睘浜庢棤瀹宠鍛婏紝闈欓煶鎺夎鏋勫缓杈撳嚭骞插噣 -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <!--
    涓ゅ澶栬锛屽悓涓€浠芥簮鐮侊細
      * 榛樿锛圢oArt 鏈寚瀹氾級锛氬鏋滃綋鍓嶇洰褰曢噷瀛樺湪 frame_top.png / header_icon.png锛?        灏辩敤瀹冧滑鍋氶《閮ㄥ笜骞曚笌鍙充笂瑙掔珛缁橈紙杩欐槸銆屽甫缇庢湳鐗堛€嶏紝浠呬緵鏈湴鑷敤锛屼笉瑕佸叕寮€鍒嗗彂锛夈€?      * 杩欎袱涓枃浠朵笉瀛樺湪鏃惰嚜鍔ㄥ垏鍒?NOART锛氭墍鏈夎楗版敼涓虹▼搴忚嚜缁橈紙绾搁潰 + 閰掔孩 + 浜旂嚎璋?+ 璋卞彿瀛楀舰锛夛紝
        浜х墿閲屼笉鍚换浣曟父鎴忓浘鐗?鈥斺€?浠撳簱鍜?Release 閲屽彂甯冪殑灏辨槸杩欎竴鐗堛€?    涔熷彲浠ユ樉寮忔寚瀹氾細dotnet build -c Release -p:NoArt=true / -p:NoArt=false
  -->
  <PropertyGroup Condition="'$(NoArt)' == '' and !Exists('$(MSBuildProjectDirectory)\frame_top.png')">
    <NoArt>true</NoArt>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NoArt)' == 'true'">
    <DefineConstants>$(DefineConstants);NOART</DefineConstants>
    <AssemblyTitle>SR Perfect Patch 鈥?Symphonic Rain judgement overlay (no-art build)</AssemblyTitle>
    <ApplicationIcon>app_noart.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NoArt)' != 'true'">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_rollback\**" />
    <EmbeddedResource Remove="_rollback\**" />
    <None Remove="_rollback\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(NoArt)' != 'true'">
    <EmbeddedResource Include="frame_top.png" LogicalName="frame_top.png" Condition="Exists('frame_top.png')" />
    <EmbeddedResource Include="header_icon.png" LogicalName="header_icon.png" Condition="Exists('header_icon.png')" />
  </ItemGroup>

</Project>
